"[dbo].[discounts]":"stor_id":w -> "[dbo].[stores]":"stor_id":e [dir=back arrowhead=dot arrowtail=crow];
"[dbo].[employee]":"job_id":w -> "[dbo].[jobs]":"job_id":e [dir=back arrowhead=dot arrowtail=crow];
