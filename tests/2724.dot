digraph {
    node [width="1.3"]

    subgraph{
      rank=source
      node [shape=none label="" height=0]
      e1 e2  e3
    }

    subgraph A {
      rank = same
      in1 -> in2 -> in3
      in3:nw -> in1:ne
    }

    subgraph {
      rank=same
      out1:se -> out3:sw;
      out1 -> out2 -> out3 [dir=back];
    }

    subgraph{
      rank=sink
      node [shape=none label="" height=0]
      r1 r2 r3
    }

    in1->out1
    in2->out2
    in3->out3

    e1->in1
    e2->in2
    e3->in3

    out1->r1
    out2->r2
    out3->r3
}
